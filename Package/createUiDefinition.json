{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "getLAWorkspace",
        "type": "Microsoft.Solutions.ArmApiControl",
        "toolTip": "This filters by workspaces that exist in the Resource Group selected",
        "condition": "[greater(length(resourceGroup().name),0)]",
        "request": {
          "method": "GET",
          "path": "[concat(subscription().id,'/providers/Microsoft.OperationalInsights/workspaces?api-version=2020-08-01')]"
        }
      },
      {
        "name": "workspace",
        "type": "Microsoft.Common.DropDown",
        "label": "Workspace",
        "placeholder": "Select a workspace",
        "toolTip": "This dropdown will list only workspace that exists in the Resource Group selected",
        "constraints": {
          "allowedValues": "[map(filter(basics('getLAWorkspace').value, (filter) => contains(toLower(filter.id), toLower(resourceGroup().name))), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
          "required": true
        },
        "visible": true
      }
    ],
    "steps": [
      {
        "name": "KeepIt",
        "label": "KeepIt Details",
        "elements": [
          {
            "name": "KeepItHost",
            "type": "Microsoft.Common.DropDown",
            "label": "KeepIt Host",
            "placeholder": "",
            "defaultValue": "Germany",
            "toolTip": "",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Australia",
                  "value": "https://au-sy.keepit.com"
                },
                {
                  "label": "Canada",
                  "value": "https://ca-tr.keepit.com"
                },
                {
                  "label": "Denmark",
                  "value": "https://dk-co.keepit.com"
                },
                {
                  "label": "Germany",
                  "value": "https://de-fr.keepit.com"
                },
                {
                  "label": "Switzerland",
                  "value": "https://ch-zh.keepit.com"
                },
                {
                  "label": "United Kingdom",
                  "value": "https://uk-ld.keepit.com"
                },
                {
                  "label": "United States",
                  "value": "https://us-dc.keepit.com"
                }
              ],
              "required": true
            },
            "visible": true
          },
          {
            "name": "KeepItAccountName",
            "type": "Microsoft.Common.TextBox",
            "label": "KeepIt AccountName",
            "placeholder": "",
            "defaultValue": "",
            "toolTip": "Use only allowed characters",
            "constraints": {
              "required": true
            },
            "visible": true,
            "options": {
              "text": "Select the correct KeepIt environment",
              "link": {
                "label": "Learn more",
                "uri": "https://www.keepit.com/help/api-category/authentication/?"
              }
            }
          },
          {
            "name": "KeepItLoginName",
            "type": "Microsoft.Common.TextBox",
            "label": "KeepIt Login",
            "placeholder": "",
            "defaultValue": "",
            "toolTip": "Use only allowed characters",
            "constraints": {
              "required": true
            },
            "visible": true,
            "options": {
              "text": "Select the correct KeepIt environment",
              "link": {
                "label": "Learn more",
                "uri": "https://www.keepit.com/help/api-category/authentication/?"
              }
            }
          },
          {
            "name": "KeepItPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": "KeepIt Password",
            "placeholder": "",
            "defaultValue": "",
            "toolTip": "",
            "constraints": {
              "required": true
            },
            "options": {
              "hideConfirmation": true,
              "link": {
                "label": "Lean more",
                "uri": "https://www.keepit.com/help/api-category/authentication/?"
              }
            }
          }
        ]
      }
    ],
    "outputs": {
      "workspaceName": "[basics('workspace')]",
      "KeepItHost": "[steps('KeepIt').KeepItHost]",
      "KeepItAccountName": "[steps('KeepIt').KeepItAccountName]",
      "KeepItLoginName": "[steps('KeepIt').KeepItLoginName]",
      "KeepItPassword": "[steps('KeepIt').KeepItPassword]"
    }
  }
}