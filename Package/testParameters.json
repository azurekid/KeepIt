{
  "workspaceName": {
    "type": "string",
    "metadata": {
      "description": "Name of the Log Analytics workspace."
    }
  },
  "functionName": {
    "type": "string",
    "defaultValue": "KeepIt",
    "minLength": 1,
    "maxLength": 15,
    "metadata": {
      "description": "Specifies the name of the Function App."
    }
  },
  "KeepItAccountName": {
    "type": "string",
    "metadata": {
      "description": "Specifies the name of the KeepIt account."
    }
  },
  "KeepItHost": {
    "type": "string",
    "metadata": {
      "description": "uri to the API endpoint to query data."
    },
    "defaultValue": "https://de-fr.keepit.com"
  },
  "KeepItLoginName": {
    "type": "string",
    "metadata": {
      "description": "Specifies the name of the KeepIt account."
    }
  },
  "KeepItPassword": {
    "type": "securestring",
    "metadata": {
      "description": "Specifies the password of the KeepIt account."
    }
  },
  "baseUri": {
    "type": "string",
    "metadata": {
      "description": "Specifies the URI of the arifacts on GitHub"
    },
    "defaultValue": "https://raw.githubusercontent.com/azure/azure-sentinel/refs/heads/main/Data%20Connectors/KeepIt/deployment/"
  }
}