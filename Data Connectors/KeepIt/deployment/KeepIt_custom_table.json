{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Log Analytics workspace."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location of the Log Analytics workspace"
      }
    },
    "tableName": {
      "type": "string",
      "defaultValue": "KeepitAuditLogs_CL",
      "metadata": {
        "description": "Name of the custom table to create."
      }
    }
  },
  "variables": {
    "customTable": "[format('Custom-{0}', parameters('tableName'))]",
    "regionShortCodes": {
      "eastus": "eus",
      "eastus2": "eus2",
      "westus": "wus",
      "westus2": "wus2",
      "westus3": "wus3",
      "centralus": "cus",
      "northcentralus": "ncus",
      "southcentralus": "scus",
      "canadacentral": "cac",
      "canadaeast": "cae",
      "brazilsouth": "brs",
      "northeurope": "neu",
      "westeurope": "weu",
      "uksouth": "uks",
      "ukwest": "ukw",
      "francecentral": "frc",
      "francesouth": "frs",
      "germanywestcentral": "gwc",
      "swedencentral": "swc",
      "swedensouth": "sws",
      "norwayeast": "nwe",
      "switzerlandnorth": "chn",
      "switzerlandwest": "chw",
      "italynorth": "itn",
      "spaincentral": "spc",
      "polandcentral": "plc",
      "uaenorth": "uan",
      "qatarcentral": "qac",
      "southafricanorth": "zan",
      "australiaeast": "aue",
      "australiasoutheast": "ause",
      "australiacentral": "auc",
      "japaneast": "jpe",
      "japanwest": "jpw",
      "koreacentral": "krc",
      "koreasouth": "krs",
      "eastasia": "eas",
      "southeastasia": "sea",
      "centralindia": "cin",
      "southindia": "sin",
      "westindia": "win"
    },
    "normalizedLocation": "[toLower(replace(parameters('location'), ' ', ''))]",
    "derivedLocationShortCode": "[if(contains(variables('regionShortCodes'), variables('normalizedLocation')), variables('regionShortCodes')[variables('normalizedLocation')], take(variables('normalizedLocation'), 3))]",
    "dceName": "[toLower(format('dce-keepit-{0}-{1}', variables('derivedLocationShortCode'), '001'))]",
    "dcrName": "[toLower(format('dcr-keepit-{0}-{1}', variables('derivedLocationShortCode'), '001'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2021-04-01",
      "name": "[variables('dceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2021-09-01-preview",
      "name": "[variables('dcrName')]",
      "location": "[parameters('location')]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[parameters('workspaceName')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "[variables('customTable')]"
            ],
            "destinations": [
              "[parameters('workspaceName')]"
            ],
            "outputStream": "[variables('customTable')]",
            "transformKql": "source | extend TimeGenerated = uploadtime"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), parameters('tableName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2021-12-01-preview",
      "name": "[format('{0}/{1}', parameters('workspaceName'), parameters('tableName'))]",
      "properties": {
        "schema": {
          "name": "[parameters('tableName')]",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime"
            },
            {
              "name": "uploadtime",
              "type": "datetime"
            },
            {
              "name": "account",
              "type": "string"
            },
            {
              "name": "connector",
              "type": "string"
            },
            {
              "name": "acl",
              "type": "string"
            },
            {
              "name": "method",
              "type": "string"
            },
            {
              "name": "user",
              "type": "string"
            },
            {
              "name": "ipaddress",
              "type": "string"
            },
            {
              "name": "event",
              "type": "string"
            },
            {
              "name": "metadata",
              "type": "dynamic"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "dceName": {
      "type": "string",
      "value": "[variables('dceName')]"
    },
    "dcrName": {
      "type": "string",
      "value": "[variables('dcrName')]"
    },
    "dataCollectionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2021-04-01').logsIngestion.endpoint]"
    },
    "immutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2021-04-01').immutableId]"
    },
    "endpointUri": {
      "type": "string",
      "value": "[format('{0}/dataCollectionRules/{1}/streams/{2}?api-version=2021-11-01-preview', reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2021-04-01').logsIngestion.endpoint, reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), '2021-09-01-preview').immutableId, variables('customTable'))]"
    }
  }
}