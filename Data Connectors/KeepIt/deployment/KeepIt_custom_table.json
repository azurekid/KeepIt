{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Log Analytics workspace."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location of the Log Analytics workspace"
      }
    },
    "TableName": {
      "type": "string",
      "defaultValue": "KeepitAuditLogs_CL",
      "metadata": {
        "description": "Name of the custom table to create."
      }
    }
  },
  "variables": {
    "customTable": "[format('Custom-{0}', 'KeepitAuditLogs_CL')]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2021-04-01",
      "name": "KeepIt",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2021-09-01-preview",
      "name": "KeepIt",
      "location": "[parameters('location')]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', 'KeepIt')]",
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "[parameters('workspaceName')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "[variables('customTable')]"
            ],
            "destinations": [
              "[parameters('workspaceName')]"
            ],
            "outputStream": "[variables('customTable')]",
            "transformKql": "source | extend TimeGenerated = now()"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', 'KeepIt')]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'KeepitAuditLogs_CL')]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2021-12-01-preview",
      "name": "[format('{0}/{1}', parameters('workspaceName'), 'KeepitAuditLogs_CL')]",
      "properties": {
        "schema": {
          "name": "[parameters('tableName')]",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime"
            },
            {
              "name": "uploadtime",
              "type": "datetime"
            },
            {
              "name": "account",
              "type": "string"
            },
            {
              "name": "connector",
              "type": "string"
            },
            {
              "name": "acl",
              "type": "string"
            },
            {
              "name": "method",
              "type": "string"
            },
            {
              "name": "user",
              "type": "string"
            },
            {
              "name": "ipaddress",
              "type": "string"
            },
            {
              "name": "event",
              "type": "string"
            },
            {
              "name": "metadata",
              "type": "dynamic"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "dataCollectionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', 'KeepIt'), '2021-04-01').logsIngestion.endpoint]"
    },
    "immutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', 'KeepIt'), '2021-04-01').immutableId]"
    },
    "endpointUri": {
      "type": "string",
      "value": "[format('{0}/dataCollectionRules/{1}/streams/{2}?api-version=2021-11-01-preview', reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', 'KeepIt'), '2021-04-01').logsIngestion.endpoint, reference(resourceId('Microsoft.Insights/dataCollectionRules', 'KeepIt'), '2021-09-01-preview').immutableId, variables('customTable'))]"
    }
  }
}