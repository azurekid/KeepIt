{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspaceName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Log Analytics workspace."
            }
        },
        "functionName": {
            "type": "string",
            "defaultValue": "KeepIt",
            "minLength": 1,
            "maxLength": 15,
            "metadata": {
                "description": "Specifies the name of the Function App."
            }
        },
        "KeepItAccountName": {
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the KeepIt account."
            }
        },
        "KeepItHost": {
            "type": "string",
            "metadata": {
                "description": "uri to the API endpoint to query data."
            },
            "defaultValue": "https://de-fr.keepit.com"
        },
        "KeepItLoginName": {
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the KeepIt account."
            }
        },
        "KeepItPassword": {
            "type": "securestring",
            "metadata": {
                "description": "Specifies the password of the KeepIt account."
            }
        },
        "baseUri": {
            "type": "string",
            "metadata": {
                "description": "Specifies the URI of the arifacts on GitHub"
            },
            "defaultValue": "https://raw.githubusercontent.com/azurekid/KeepIt/refs/heads/main/Data%20Connectors/KeepIt/deployment/"
        }
    },
    "variables": {
        "regionShortCodes": {
            "eastus": "eus",
            "eastus2": "eus2",
            "westus": "wus",
            "westus2": "wus2",
            "westus3": "wus3",
            "centralus": "cus",
            "northcentralus": "ncus",
            "southcentralus": "scus",
            "canadacentral": "cac",
            "canadaeast": "cae",
            "brazilsouth": "brs",
            "northeurope": "neu",
            "westeurope": "weu",
            "uksouth": "uks",
            "ukwest": "ukw",
            "francecentral": "frc",
            "francesouth": "frs",
            "germanywestcentral": "gwc",
            "swedencentral": "swc",
            "swedensouth": "sws",
            "norwayeast": "nwe",
            "switzerlandnorth": "chn",
            "switzerlandwest": "chw",
            "italynorth": "itn",
            "spaincentral": "spc",
            "polandcentral": "plc",
            "uaenorth": "uan",
            "qatarcentral": "qac",
            "southafricanorth": "zan",
            "australiaeast": "aue",
            "australiasoutheast": "ause",
            "australiacentral": "auc",
            "japaneast": "jpe",
            "japanwest": "jpw",
            "koreacentral": "krc",
            "koreasouth": "krs",
            "eastasia": "eas",
            "southeastasia": "sea",
            "centralindia": "cin",
            "southindia": "sin",
            "westindia": "win"
        },
        "normalizedLocation": "[toLower(replace(resourceGroup().location, ' ', ''))]",
        "derivedLocationShortCode": "[if(contains(variables('regionShortCodes'), variables('normalizedLocation')), variables('regionShortCodes')[variables('normalizedLocation')], take(variables('normalizedLocation'), 3))]"
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "KeepItTable",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[uri(parameters('baseUri'), 'KeepIt_custom_table.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "workspaceName": {
                        "value": "[parameters('workspaceName')]"
                    },
                    "functionName": {
                        "value": "[parameters('functionName')]"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "FunctionApp",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[uri(parameters('baseUri'), 'KeepIt_function_app.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "functionName": {
                        "value": "[parameters('functionName')]"
                    },
                    "KeepItAccountName": {
                        "value": "[parameters('KeepItAccountName')]"
                    },
                    "KeepItHost": {
                        "value": "[parameters('KeepItHost')]"
                    },
                    "KeepItLoginName": {
                        "value": "[parameters('KeepItLoginName')]"
                    },
                    "KeepItPassword": {
                        "value": "[parameters('KeepItPassword')]"
                    },
                    "dataCollectionEndpoint": {
                        "value": "[reference('KeepItTable').outputs.endpointUri.value]"
                    },
                    "dataCollectionRuleName": {
                        "value": "[reference('KeepItTable').outputs.dcrName.value]"
                    }
                }
            },
            "dependsOn": [
                "KeepItTable"
            ]
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "DataConnector",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[uri(parameters('baseUri'), 'KeepIt_data_connector.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "workspaceName": {
                        "value": "[parameters('workspaceName')]"
                    }
                }
            },
            "dependsOn": [
                "KeepItTable"
            ]
        }
    ]
}