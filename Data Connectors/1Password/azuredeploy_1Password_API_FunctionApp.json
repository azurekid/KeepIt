{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspaceName": {
            "type": "string",
            "metadata": {
                "description": "Name of the Log Analytics workspace."
            }
        },
        "functionName": {
            "type": "string",
            "defaultValue": "KeepIt",
            "minLength": 1,
            "maxLength": 11,
            "metadata": {
                "description": "Specifies the name of the Function App."
            }
        },
        "KeepItAccountName": {
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the KeepIt account."
            }
        },
        "KeepItHost": {
            "type": "string",
            "metadata": {
                "description": "uri to the API endpoint to query data."
            },
            "defaultValue": "https://de-fr.keepit.com"
        },
        "KeepItLoginName": {
            "type": "string",
            "metadata": {
                "description": "Specifies the name of the KeepIt account."
            }
        },
        "KeepItPassword": {
            "type": "securestring",
            "metadata": {
                "description": "Specifies the password of the KeepIt account."
            }
        },
        "baseUri": {
            "type": "string",
            "metadata": {
                "description": "Specifies the URI of the arifacts on GitHub"
            },
            "defaultValue": "https://raw.githubusercontent.com/SecureHats/Azure-Sentinel/master/Solutions/1Password/Data%20Connectors/1Password/deployment/"
        }
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "KeepItTable",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[uri(parameters('baseUri'), 'KeepIt_custom_table.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "workspaceName": {
                        "value": "[parameters('workspaceName')]"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "FunctionApp",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[uri(parameters('baseUri'), 'KeepIt_function_app.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "functionName": {
                        "value": "[parameters('functionName')]"
                    },
                    "KeepItAccountName": {
                        "value": "[parameters('KeepItAccountName')]"
                    },
                    "KeepItHost": {
                        "value": "[parameters('KeepItHost')]"
                    },
                    "KeepItLoginName": {
                        "value": "[parameters('KeepItLoginName')]"
                    },
                    "KeepItPassword": {
                        "value": "[parameters('KeepItPassword')]"
                    },
                    "dataCollectionEndpoint": {
                        "value": "[reference('1PasswordTable').outputs.endpointUri.value]"
                    }
                }
            },
            "dependsOn": [
                "1PasswordTable"
            ]
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "DataConnector",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[uri(parameters('baseUri'), 'KeepIt_data_connector.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "workspaceName": {
                        "value": "[parameters('workspaceName')]"
                    }
                }
            },
            "dependsOn": [
                "KeepItTable"
            ]
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "AnalyticsRules",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "https://raw.githubusercontent.com/SecureHats/Azure-Sentinel/master/Solutions/1Password/Package/mainTemplate.json",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "workspace": {
                        "value": "[parameters('workspaceName')]"
                    },
                    "workspace-location": {
                        "value": "[resourceGroup().location]"
                    }
                }
            },
            "dependsOn": [
                "KeepItTable",
                "DataConnector",
                "FunctionApp"
            ]
        }
    ]
}